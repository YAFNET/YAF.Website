@using YAF.Core.Context
@using YAF.Core.Extensions

@inject BoardContext Current

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" type="text/css" href="~/css/forum.min.css" asp-append-version="true">
    <link rel="stylesheet" type="text/css" href="~/css/themes/cosmo/bootstrap-forum.min.css" asp-append-version="true">
    <link rel="preload" href="~/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin />
    <script src="~/js/themeSelector.min.js"></script>
</head>
<body>
    @await Html.PartialAsync("_SiteHeader")

    <main class="container">
        @RenderBody()
    </main>

    @await Html.PartialAsync("_SiteFooter", false)

     <script src="~/js/forumExtensions.min.js" asp-append-version="true"></script>

@if (!Current.IsGuest)
{
    @await Html.PartialAsync("_LogoutConfirm")
}

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>