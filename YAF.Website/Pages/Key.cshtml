@page
@using YAF.Types.Extensions
@model YAF.Website.Pages.KeyModel

@{
    ViewData["Title"] = "Generate a Machine Key for your installation";
}

<div class="px-3 py-3 pt-md-5 pb-md-4 mx-auto text-center">
    <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-bg-primary fs-3 mb-3" style="width:4rem;height:4rem">
        <i class="fa-solid fa-key"></i>
    </span>
    <h1 class="display-5">Machine Key Generator</h1>
    <p class="lead">Generate a random ASP.NET machine key for validation and encryption/decryption of the view state in your YAF.NET v3 installation.</p>
    <span class="badge rounded-pill text-bg-secondary fs-6">YAF.NET v3.x.x only</span>
</div>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="alert alert-warning d-flex align-items-center">
            <i class="fa-solid fa-triangle-exclamation fs-4 me-3"></i>
            <div>
                This tool is only for <strong>YAF.NET v3.x.x</strong> (.NET Framework). Version <strong>4.0.0</strong> or higher does not need a machine key.
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h2 class="h5"><i class="fa-solid fa-server text-primary me-2"></i>Web Farms</h2>
                        <p class="card-text text-body-secondary mb-0">All server nodes need to use the same machine key.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h2 class="h5"><i class="fa-solid fa-rotate text-primary me-2"></i>Single Server</h2>
                        <p class="card-text text-body-secondary mb-0">Keeps the machine key the same between IIS recycles and server reboots.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form method="post" class="text-center">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-wand-magic-sparkles me-1"></i>@(Model.OutputKey.IsSet() ? "Generate New Key" : "Generate Key")
                    </button>
                </form>

                @if (Model.OutputKey.IsSet())
                {
                    <div class="d-flex justify-content-between align-items-center mt-4 mb-2">
                        <h2 class="h5 mb-0">Your Machine Key</h2>
                        <button type="button" class="btn btn-sm btn-outline-secondary copy-button" data-copy-target="outputKey">
                            <i class="fa-solid fa-copy me-1"></i><span>Copy</span>
                        </button>
                    </div>
                    <pre class="bg-body-tertiary p-3 rounded-3 text-wrap text-break"><code id="outputKey" class="language-xml">@(Model.OutputKey)</code></pre>
                    <div class="alert alert-success d-flex align-items-center mb-0">
                        <i class="fa-solid fa-circle-check fs-4 me-3"></i>
                        <div>Copy the generated machine key into the <code>&lt;system.web&gt;</code> section of your <code>web.config</code>.</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_CopyScript" />
}
