@page
@model YAF.Website.Pages.IndexModel

@{
    ViewData["Title"] = "Free Open Source C# ASP.NET Forum Software - YetAnotherForum.NET";

    var highlights = new (string Icon, string Title, string Text)[]
    {
        ("fa-shield-halved", "Stable and Secure",
            "YAF.NET has been around since 2003 and is developed in the open. Two-factor authentication, extensive banning options and built-in spam protection keep your community safe."),
        ("fa-bolt", "Great Performance",
            "Most long queries are cached. Even for forums with a large number of users and posts, YAF.NET handles the job quickly with modest hosting requirements."),
        ("fa-layer-group", "Integrated",
            "Run YAF.NET as a stand-alone application, as a Docker container, or integrate it as an area inside your own ASP.NET Core Razor Pages application."),
        ("fa-globe", "Localized",
            "Used throughout the globe with 25 included languages, right-to-left layouts and a built-in language editor to easily change any translation."),
        ("fa-bell", "Real-Time",
            "Real-time notifications, browser push notifications and direct chat messages keep your members up to date and coming back."),
        ("fa-palette", "Beautiful Themes",
            "Built with Bootstrap and 27 included Bootswatch themes. Responsive on every device and installable as a Progressive Web App.")
    };

    var stats = new (string Value, string Label)[]
    {
        ("2003", "Since"),
        ("25", "Languages"),
        ("27", "Themes"),
        ("4", "Databases")
    };
}

<!-- Hero -->
<section class="py-4 py-md-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6 text-center text-lg-start">
            <span class="badge rounded-pill text-bg-primary mb-3">Free &amp; Open Source &middot; Apache 2.0</span>
            <h1 class="display-4 fw-bold">Build your community with YAF.NET</h1>
            <p class="lead my-4">
                We're focused on fostering community. YAF.NET is open source, freely available and supported by people in most parts of the globe.
                Stable, fast and mature, with advanced features to empower you and your community.
            </p>
            <div class="d-grid gap-2 d-sm-flex justify-content-center justify-content-lg-start">
                <a class="btn btn-primary btn-lg px-4" asp-area="" asp-page="/GetStarted">
                    <i class="fa-solid fa-rocket me-1"></i>Get Started
                </a>
                <a class="btn btn-outline-primary btn-lg px-4" asp-area="" asp-page="/Features">
                    <i class="fa-solid fa-list-check me-1"></i>Features
                </a>
                <a class="btn btn-outline-secondary btn-lg px-4" asp-area="Forums" asp-page="/Index">
                    <i class="fa-solid fa-comments me-1"></i>Community Forum
                </a>
            </div>
        </div>
        <div class="col-lg-6">
            <img class="img-fluid rounded-3 shadow" src="~/images/img1.png" alt="YAF.NET forum screenshot">
        </div>
    </div>
</section>

<!-- Stats -->
<section class="my-4">
    <div class="row row-cols-2 row-cols-md-4 g-3 text-center">
        @foreach (var stat in stats)
        {
            <div class="col">
                <div class="border rounded-3 py-3 h-100">
                    <div class="display-6 fw-bold text-primary">@stat.Value</div>
                    <div class="text-body-secondary">@stat.Label</div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Highlights -->
<section class="my-5">
    <h2 class="text-center mb-4">
        YAF.NET <strong>Community First</strong>
    </h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var highlight in highlights)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-3 text-bg-primary fs-4 mb-3" style="width:3rem;height:3rem">
                            <i class="fa-solid @highlight.Icon"></i>
                        </span>
                        <h3 class="h5 card-title">@highlight.Title</h3>
                        <p class="card-text text-body-secondary">@highlight.Text</p>
                    </div>
                </div>
            </div>
        }
    </div>
    <div class="text-center mt-4">
        <a class="btn btn-outline-primary" asp-area="" asp-page="/Features">
            See all features<i class="fa-solid fa-arrow-right ms-2"></i>
        </a>
    </div>
</section>

<!-- Tech -->
<section class="my-5">
    <div class="row g-4 align-items-stretch">
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h4 mb-3"><i class="fa-solid fa-microchip text-primary me-2"></i>Built on Modern .NET</h2>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>100% managed C# ASP.NET Core, .NET 10 and above</li>
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>Built with the <a href="https://getbootstrap.com/" target="_blank">Bootstrap Framework</a></li>
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>Unlimited boards, forums and topics</li>
                        <li class="mb-2"><i class="fa-solid fa-check text-success me-2"></i>SEO friendly URLs and responsive layout</li>
                        <li><i class="fa-solid fa-check text-success me-2"></i>Open Source, Apache 2.0 licensed</li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h4 mb-3"><i class="fa-solid fa-database text-primary me-2"></i>Your Database of Choice</h2>
                    <div class="row row-cols-2 g-2">
                        <div class="col"><div class="border rounded-3 p-2 text-center">MS SQL Server</div></div>
                        <div class="col"><div class="border rounded-3 p-2 text-center">MySQL / MariaDB</div></div>
                        <div class="col"><div class="border rounded-3 p-2 text-center">PostgreSQL</div></div>
                        <div class="col"><div class="border rounded-3 p-2 text-center">SQLite</div></div>
                    </div>
                    <p class="text-body-secondary mt-3 mb-0">MS SQL Server 2012 and above. Every database has its own ready-made Docker image.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Docker -->
<section class="my-5">
    <div class="card shadow-sm border-0 text-bg-dark">
        <div class="card-body p-4 p-md-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-5">
                    <h2 class="h3"><i class="fa-brands fa-docker me-2"></i>Up and running in minutes</h2>
                    <p class="mb-4">Try YAF.NET with Docker and SQLite, then open <code>http://localhost:8001</code> and follow the installation wizard.</p>
                    <a class="btn btn-light" asp-area="" asp-page="/GetStarted">
                        Read the setup guide<i class="fa-solid fa-arrow-right ms-2"></i>
                    </a>
                </div>
                <div class="col-lg-7">
<pre class="bg-black text-light p-3 rounded-3 mb-0"><code>docker run -d -p 8001:89 \
  -e ASPNETCORE_URLS=http://+:89 \
  -e BoardConfiguration__ConnectionProviderName=System.Data.SQLite \
  -e "ConnectionStrings__DefaultConnection=Data Source=/data/yafnet.db;Version=3;" \
  -v yafnet-data:/data \
  yafnet/yafnet:latest-sqlite</code></pre>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="my-5 text-center">
    <h2>Why not get started today?</h2>
    <p class="lead text-body-secondary">Join the community, ask questions and share your ideas.</p>
    <div class="d-grid gap-2 d-sm-flex justify-content-center">
        <a class="btn btn-primary btn-lg px-4" asp-area="" asp-page="/Downloads">
            <i class="fa-solid fa-download me-1"></i>Download
        </a>
        <a class="btn btn-outline-primary btn-lg px-4" asp-area="Forums" asp-page="/Index">
            <i class="fa-solid fa-life-ring me-1"></i>Support Forum
        </a>
        <a class="btn btn-outline-secondary btn-lg px-4" href="https://github.com/YAFNET/YAFNET" target="_blank">
            <i class="fa-brands fa-github me-1"></i>GitHub
        </a>
    </div>
</section>
