<div class="px-3 py-3 pt-md-5 pb-md-4 mx-auto text-center">
    <h1 class="display-4">Features</h1>
    <p class="lead">
        More than @total features across @categories.Length areas &ndash; everything you need to run a modern community, out of the box.
    </p>
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                <input type="search" id="featureFilter" class="form-control" placeholder="Search features..." aria-label="Search features">
            </div>
        </div>
    </div>
</div>

<nav class="d-flex flex-wrap justify-content-center gap-2 mb-4" aria-label="Feature categories">
    @foreach (var category in categories)
    {
        <a href="#@category.Id" class="btn btn-sm btn-outline-secondary feature-jump" data-category="@category.Id">
            <i class="fa-solid @category.Icon me-1"></i>@category.Title
        </a>
    }
</nav>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4" id="featureGrid">
    @foreach (var category in categories)
    {
        <div class="col feature-category" id="@category.Id">
            <div class="card h-100 shadow-sm">
                <div class="card-header d-flex align-items-center">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle text-bg-primary me-2" style="width:2.25rem;height:2.25rem">
                        <i class="fa-solid @category.Icon"></i>
                    </span>
                    <h2 class="h5 mb-0 flex-grow-1">@category.Title</h2>
                    <span class="badge rounded-pill text-bg-light">@category.Items.Length</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var item in category.Items)
                    {
                        <li class="list-group-item feature-item d-flex">
                            <i class="fa-solid fa-check text-success me-2 mt-1"></i>
                            <span>@Html.Raw(item)</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
</div>

<div id="featureNoResults" class="alert alert-secondary text-center mt-4 d-none">
    No features found. Ask in the <a asp-area="Forums" asp-page="/Index">Support Forum</a> if you are missing something.
</div>

<div class="text-center mt-5">
    <h2 class="h3">Ready to try it?</h2>
    <p>Set up your own forum with Docker in a few minutes.</p>
    <a class="btn btn-lg btn-primary me-2" asp-area="" asp-page="/GetStarted">
        <i class="fa-solid fa-rocket me-1"></i>Get Started
    </a>
    <a class="btn btn-lg btn-outline-primary" asp-area="" asp-page="/Downloads">
        <i class="fa-solid fa-download me-1"></i>Downloads
    </a>
</div>

@section Scripts
{
    <script>
        (function () {
            const input = document.getElementById('featureFilter');
            const noResults = document.getElementById('featureNoResults');

            input.addEventListener('input', function () {
                const term = input.value.trim().toLowerCase();
                let anyVisible = false;

                document.querySelectorAll('.feature-category').forEach(function (category) {
                    const title = category.querySelector('h2').textContent.toLowerCase();
                    const titleMatch = term.length > 0 && title.includes(term);
                    let visibleItems = 0;

                    category.querySelectorAll('.feature-item').forEach(function (item) {
                        const match = !term || titleMatch || item.textContent.toLowerCase().includes(term);
                        item.classList.toggle('d-none', !match);
                        if (match) {
                            visibleItems++;
                        }
                    });

                    const show = visibleItems > 0;
                    category.classList.toggle('d-none', !show);
                    document.querySelector('.feature-jump[data-category="' + category.id + '"]').classList.toggle('d-none', !show);
                    anyVisible = anyVisible || show;
                });

                noResults.classList.toggle('d-none', anyVisible);
            });
        })();
    </script>
}
